[Unit]
Description=ApexIntel API Server
After=network.target postgresql.service redis-server.service nats.service
Requires=postgresql.service redis-server.service nats.service
Wants=minio.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=apexintel
Group=apexintel
WorkingDirectory=/opt/apexintel
ExecStart=/opt/apexintel/bin/apex-api
EnvironmentFile=/opt/apexintel/config/.env
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apexintel-api

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apexintel/data /opt/apexintel/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
