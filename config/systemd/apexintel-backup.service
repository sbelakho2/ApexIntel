[Unit]
Description=ApexIntel backup job
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=apexintel
Group=apexintel
WorkingDirectory=/opt/apexintel
EnvironmentFile=/opt/apexintel/config/.env
ExecStart=/usr/bin/env bash /opt/apexintel/scripts/backup.sh /opt/apexintel/backups
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apexintel-backup

[Install]
WantedBy=multi-user.target