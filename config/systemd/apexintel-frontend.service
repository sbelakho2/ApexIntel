[Unit]
Description=ApexIntel Frontend (Next.js)
After=network.target apexintel-api.service

[Service]
Type=simple
User=apexintel
Group=apexintel
WorkingDirectory=/opt/apexintel/frontend
ExecStart=/opt/apexintel/frontend/node_modules/.bin/next start -p 3000
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=NODE_ENV=production
# Auth vars loaded from shared .env via EnvironmentFile below.
# Required frontend auth vars (must be present in /opt/apexintel/config/.env):
#   APEX_ADMIN_USERNAME, APEX_ADMIN_PASSWORD_HASH, SESSION_SECRET,
#   APEX_API_KEY, APEX_API_BASE_URL, NEXT_PUBLIC_API_BASE_URL
EnvironmentFile=/opt/apexintel/config/.env
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apexintel-frontend

[Install]
WantedBy=multi-user.target
