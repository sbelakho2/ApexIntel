# ══════════════════════════════════════════════════════════════════════════════
# ApexIntel Frontend Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local for development.
# For production, set these in the systemd service or deployment config.
#
# SECURITY: Never commit actual credentials to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Application URLs ────────────────────────────────────────────────────────
# Public URL (client-visible)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Internal backend URL (server-side only)
APEX_API_BASE_URL=http://127.0.0.1:8080

# ─── Authentication (REQUIRED) ───────────────────────────────────────────────
# Admin username
APEX_ADMIN_USERNAME=admin

# SHA-256 hash of admin password
# Generate: echo -n 'yourpassword' | sha256sum | cut -d' ' -f1
APEX_ADMIN_PASSWORD_HASH=<SHA256_HASH_OF_PASSWORD>

# Session signing secret (min 32 chars)
# Generate: openssl rand -hex 32
SESSION_SECRET=<GENERATE_64_CHAR_HEX_SECRET>

# ─── API Key for Backend Access (REQUIRED) ───────────────────────────────────
# This must match the raw key part of API_KEY_1 in backend .env
# Used by server-side proxy to authenticate with backend
APEX_API_KEY=<SAME_RAW_KEY_AS_BACKEND_API_KEY_1>

# ─── Development Options ─────────────────────────────────────────────────────
# NODE_ENV=development
# PORT=3000
