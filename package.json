{
  "name": "apexintel",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test:rust",
    "test:rust": "cargo test --workspace --locked --no-fail-fast && cargo test --workspace --all-features --locked --no-fail-fast",
    "test:pg": "bash scripts/ci/run_pg_integration_suites.sh",
    "test:ci": "cargo fmt --all -- --check && bash scripts/ci/check_dataset_formats.sh && bash scripts/ci/check_frontend_removed.sh && bash scripts/ci/check_false_success.sh --self-test && bash scripts/ci/check_false_success.sh && bash scripts/ci/check_identifier_decode.sh --self-test && bash scripts/ci/check_identifier_decode.sh && cargo clippy --workspace --all-targets --locked -- -D warnings -W clippy::disallowed_methods && cargo clippy --workspace --all-targets --all-features --locked -- -D warnings -W clippy::disallowed_methods && npm run test && npm run test:pg",
    "db:purge-content": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/ops/purge_generated_content.sql",
    "db:check-legacy-lineage": "bash scripts/ci/check_legacy_migration_lineage.sh",
    "check:unused-public": "bash scripts/ci/check_unused_public_items.sh",
    "check:datasets": "bash scripts/ci/check_dataset_formats.sh",
    "test:server-ui": "node scripts/ci/e2e_server_ui.mjs",
    "test:server-ui:specs": "playwright test -c playwright.server-ui.config.cjs",
    "test:server-ui:journeys": "playwright test -c playwright.server-ui.config.cjs e2e/server-ui-tasks.spec.js e2e/server-ui-journeys.spec.js",
    "test:server-ui:specs:update": "playwright test -c playwright.server-ui.config.cjs --update-snapshots"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbelakho2/ApexIntel.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sbelakho2/ApexIntel/issues"
  },
  "homepage": "https://github.com/sbelakho2/ApexIntel#readme",
  "dependencies": {
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "pg": "^8.23.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
