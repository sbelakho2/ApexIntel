    "test:ui-parity:update": "playwright test -c playwright.config.cjs e2e/html-ui.spec.js --update-snapshots",
    "test:e2e": "playwright test -c playwright.config.cjs",
    "test:e2e:ui": "playwright test -c playwright.config.cjs --ui",
    "test:server-ui": "node scripts/ci/e2e_server_ui.mjs"
  },
