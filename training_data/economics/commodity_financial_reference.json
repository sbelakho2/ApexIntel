  "financial_health_signals": {
    "description": "Financial metrics used in the learning crate for company financial health scoring",
    "metrics": [
      {"name": "Current Ratio", "formula": "Current Assets / Current Liabilities", "healthy_range": ">1.5", "signal": "Short-term liquidity"},
      {"name": "Quick Ratio", "formula": "(Current Assets - Inventory) / Current Liabilities", "healthy_range": ">1.0", "signal": "Immediate liquidity"},
      {"name": "Debt-to-Equity", "formula": "Total Debt / Total Equity", "healthy_range": "<2.0 (industry-dependent)", "signal": "Leverage/solvency"},
      {"name": "Interest Coverage", "formula": "EBIT / Interest Expense", "healthy_range": ">3.0", "signal": "Debt service ability"},
      {"name": "Gross Margin", "formula": "(Revenue - COGS) / Revenue", "healthy_range": "15-30% for EMS", "signal": "Pricing power"},
      {"name": "Operating Margin", "formula": "Operating Income / Revenue", "healthy_range": "3-8% for EMS", "signal": "Operational efficiency"},
      {"name": "Net Margin", "formula": "Net Income / Revenue", "healthy_range": "2-5% for EMS", "signal": "Overall profitability"},
      {"name": "Return on Equity", "formula": "Net Income / Shareholders' Equity", "healthy_range": ">15%", "signal": "Capital efficiency"},
      {"name": "Return on Assets", "formula": "Net Income / Total Assets", "healthy_range": ">5%", "signal": "Asset utilization"},
      {"name": "Revenue Growth (YoY)", "formula": "(Rev_t - Rev_t-1) / Rev_t-1", "healthy_range": ">5%", "signal": "Growth trajectory"},
      {"name": "Days Sales Outstanding", "formula": "Accounts Receivable / (Revenue/365)", "healthy_range": "<60 days", "signal": "Collection efficiency"},
      {"name": "Inventory Turnover", "formula": "COGS / Average Inventory", "healthy_range": ">6x for EMS", "signal": "Inventory management"},
      {"name": "Altman Z-Score", "formula": "1.2*A + 1.4*B + 3.3*C + 0.6*D + 1.0*E", "healthy_range": ">2.99 (safe zone)", "signal": "Bankruptcy probability"},
      {"name": "Piotroski F-Score", "formula": "Sum of 9 binary signals", "healthy_range": "7-9 (strong)", "signal": "Financial strength composite"}
    ]
  },
