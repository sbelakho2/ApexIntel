# ────────────────────────────────────────────────────────────────────────────
# Dockerfile.api — ApexIntel API server (multi-stage build)
# Build:  docker build -f Dockerfile.api -t apexintel-api .
# Run:    docker run --env-file .env -p 8080:8080 apexintel-api
# ────────────────────────────────────────────────────────────────────────────

# Pinned to rust-toolchain.toml (same as Dockerfile.worker).
FROM rust:1.98.0-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS builder
WORKDIR /build

# Cache dependency compilation
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
# `apex-store` embeds `migrations/` via `sqlx::migrate!` and `apex-core` embeds
# `config/intelligence_profiles.yaml` via `include_str!`, both at compile time,
# so the full migrations and config trees must be in the build context.
COPY config/ config/
COPY migrations/ migrations/
RUN --mount=type=cache,id=apex-target,sharing=shared,target=/build/target \
    --mount=type=cache,id=apex-cargo-registry,sharing=shared,target=/usr/local/cargo/registry \
    cargo build --release --bin apex-api --features llm --locked \
    && cp target/release/apex-api /usr/local/bin/apex-api

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libssl3 curl && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r apexintel && useradd -r -g apexintel -d /opt/apexintel apexintel
WORKDIR /opt/apexintel

COPY --from=builder /usr/local/bin/apex-api /usr/local/bin/apex-api
COPY config/ /opt/apexintel/config/
COPY --from=builder /build/crates/api/static/ /opt/apexintel/static/

RUN mkdir -p /opt/apexintel/data/search /opt/apexintel/logs && \
    chown -R apexintel:apexintel /opt/apexintel

USER apexintel
ENV RUST_LOG=info

# ServeDir resolves relative to this path in the runtime image; without it the
# container looked for /build/crates/api/static (build-stage path) and every
# CSS/JS/font request 404'd.
ENV APEX_STATIC_DIR=/opt/apexintel/static

# Search index data lives outside the image layer so it survives upgrades.
VOLUME ["/opt/apexintel/data/search"]

EXPOSE 8080

# Liveness must be cheap and must not run the full capability probe set every
# 15 seconds; `/api/health/live` is a bare 200.
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
    CMD curl -fsS http://localhost:8080/api/health/live || exit 1

CMD ["apex-api"]
