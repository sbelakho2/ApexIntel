# ══════════════════════════════════════════════════════════════════════════════
# ApexIntel Backend Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# In production, use /opt/apexintel/config/.env with chmod 600.
#
# SECURITY: Never commit actual credentials to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Deployment provenance (recorded per deploy; see scripts/ops/record_deployment.sh) ──
# /api/version and the `deployment` capability report these. Leave unset locally;
# production sets all four (missing APEX_GIT_SHA degrades the capability).
# APEX_GIT_SHA=<40-char commit>
# APEX_CI_PIPELINE_ID=<woodpecker pipeline number>
# APEX_ARTIFACT_DIGEST=sha256:<64-hex>
# APEX_DEPLOYED_AT=2026-09-26T21:00:00Z

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# Generate password: openssl rand -base64 32
# For localhost connections, sslmode is optional. For remote DB, append ?sslmode=require
DB_PASSWORD=change-me-local-dev
DATABASE_URL=postgresql://apexintel:<DB_PASSWORD>@127.0.0.1:5432/apexintel

# ─── Service URLs ────────────────────────────────────────────────────────────
# Redis authentication — set REDIS_PASSWORD to match docker-compose.yml
# Production: either set a strong random password (openssl rand -base64 32) or
# remove the password entirely if Redis is bound to localhost only.
REDIS_PASSWORD=change-me-local-dev
REDIS_URL=redis://default:<REDIS_PASSWORD>@127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-local-dev
MINIO_BUCKET=apexintel

# ─── LLM Configuration ───────────────────────────────────────────────────────
# Local llama-server for CPU inference
LLM_BASE_URL=http://127.0.0.1:8081
LLM_MODEL=Qwen3-30B-A3B-Q4_K_M
# Per-call LLM timeout. Code default is 180; production sets 600 because
# 180s is too small for 30B CPU inference of 4k-token prompts.
# LLM_TIMEOUT_SECS=180

# ─── API Server ──────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080
CORS_ORIGIN=http://localhost:8080
API_LOG_LEVEL=info
SEARCH_INDEX_PATH=data/search

# ─── Rate limiting ───────────────────────────────────────────────────────────
# RATE_LIMIT_DISABLED=true turns off per-IP limits. It is only honoured when
# the explicit test/CI override APEX_ALLOW_TEST_RATE_LIMIT_DISABLED=1 is also
# set, and the server REFUSES TO START otherwise (same pattern as
# APEX_ALLOW_TEST_SESSION_SECRET). Never set either variable in production;
# the server-rendered UI e2e suite is the only consumer.
# RATE_LIMIT_DISABLED=true
# APEX_ALLOW_TEST_RATE_LIMIT_DISABLED=1

# ─── API Authentication (REQUIRED) ───────────────────────────────────────────
# Format: <raw_key>,<display_name>,<role>
# Generate key: openssl rand -hex 32 | sed 's/^/sk-apex-/'
# Roles: admin, analyst, viewer, service
API_KEY_1=<GENERATE_API_KEY>,Development Admin,admin
# API_KEY_2=<ANOTHER_KEY>,Service Account,service

# ─── Admin authentication (for web login) ─────────────────────────────────────
# Single-admin fallback — used when WEB_USERS_JSON is unset.
APEX_ADMIN_USERNAME=admin
# Password hash — Argon2id PHC string (preferred), SINGLE-QUOTED so dotenvy
# does not expand the `$argon2id$...` segments as variable substitutions.
# Generate (in-repo, no extra tools):
#   cargo run -p apex-api --example hash_password -- 'your-password'
# Or with the argon2 CLI:
#   echo -n 'your-password' | argon2 "$(openssl rand -hex 16)" -id -e
# Legacy 64-char SHA-256 hex hashes are REJECTED by default (the documented
# sha256sum workflow cannot log in). Only set ALLOW_LEGACY_PASSWORD_HASHES=1
# to accept them temporarily while migrating to Argon2id.
APEX_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$<BASE64_SALT>$<BASE64_HASH>'
# Required: session signing secret. Generate a real value; placeholders,
# short values, and low-entropy values are rejected at startup:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional multi-user login. When set, it takes precedence over APEX_ADMIN_*.
# JSON array of {id, username, password_hash, role}; role is one of
# admin, analyst, viewer, service. Each password_hash uses the same
# Argon2id generation as above; single-quote the whole JSON in .env.
# WEB_USERS_JSON='[{"id":"usr-admin","username":"admin","password_hash":"$argon2id$v=19$...","role":"admin"},{"id":"usr-analyst","username":"analyst","password_hash":"$argon2id$v=19$...","role":"analyst"}]'

# ─── Crawl & Scheduling ──────────────────────────────────────────────────────
CRAWL_INTERVAL_SECS=3600
NIGHTLY_HOUR_UTC=2
WEEKLY_DAY=0
DEFAULT_RPS=0.2
PROXY_POOL_SIZE=50
ENABLE_PROXY_ROTATION=false

# Headless browser rendering (single persistent Chromium over CDP).
# Chromium MUST run as the dedicated non-root "apexintel" service account;
# --no-sandbox is intentionally never used, so a non-root user is required.
# Dockerfile.worker ships Chromium and sets ENABLE_HEADLESS_BROWSER=true and
# HEADLESS_BROWSER_BIN=/usr/bin/chromium inside the image. A file passed with
# `docker run --env-file` OVERRIDES those image defaults, so leave these
# commented out for the Docker worker. Bare-metal deployments: install
# Chromium and uncomment both lines to render Browser-strategy sources. With
# the feature off those sources are reported "unavailable: missing capability"
# and are never downgraded to plain HTTP.
# ENABLE_HEADLESS_BROWSER=true
# HEADLESS_BROWSER_BIN=/usr/bin/chromium    # or google-chrome / chrome-headless-shell
# HEADLESS_BROWSER_MAX_CONCURRENCY=2      # global browser ceiling (max 2)
# HEADLESS_BROWSER_TIMEOUT_SECS=30        # hard total render-time cap
# HEADLESS_BROWSER_QUIET_WINDOW_MS=1000   # network-idle window (750-1500)
# HEADLESS_BROWSER_SCROLL_STEPS=3         # bounded progressive scroll

# ─── Worker Pipeline ─────────────────────────────────────────────────────────
WORKER_LOG_LEVEL=info
NIGHTLY_INPUT_PATH=config/runtime/nightly_inputs.json
WEEKLY_INPUT_PATH=config/runtime/weekly_inputs.json

# Worker database pool ceiling. Every in-flight job holds one connection for
# its whole run, so the previous hard-coded 5 starved jobs behind the pool.
# Default 20; values outside 5..=100 are clamped to that range.
# WORKER_DB_MAX_CONNECTIONS=20

# ─── Custom Jobs ─────────────────────────────────────────────────────────────
# Operator-defined one-shot jobs. Commands are executed WITHOUT a shell: the
# command string is split into argv and argv[0] must be exactly one of the
# allowlisted binaries (a `sh -c` prefix or a script path is not allowlisted
# unless it is listed verbatim). An empty allowlist rejects every custom job.
# The child runs with a cleared environment (PATH only).
#
# CUSTOM_JOB_ALLOWLIST=/usr/local/bin/my-job,/usr/bin/other-job
# CUSTOM_JOB_COMMAND_MY_JOB="/usr/local/bin/my-job --flag value"

# ─── Dark Web Monitoring (dark_web_scan job) ─────────────────────────────────
# All variables are optional. Unset variables fall back to the built-in default
# forum list and default keyword set. A variable that is set but is not valid
# JSON fails the dark_web_scan job instead of being silently ignored.
#
# DARKWEB_TOR_PROXY=
#   Tor SOCKS5 proxy for .onion access; omit for clearnet-only scanning.
#   Example: "socks5://127.0.0.1:9050"
#
# DARKWEB_FORUMS=
#   JSON array of forums. When set, it replaces the default forum list.
#   forum_type: General | Cardshop | Exploit | Leak | Ransomware
#   access_method: Clearnet | TorOnion | I2P | Telegram
#   Example: [{"name":"BreachForums","base_url":"https://breachforums.st",
#     "forum_type":"Leak","access_method":"Clearnet","is_active":true,
#     "last_checked":null,"topics_of_interest":["leaks","databases"]}]
#
# DARKWEB_MONITORING_RULES=
#   JSON array of monitoring rules. When set, these keywords replace the
#   default keyword set used for matching.
#   Example: [{"id":"rule-1","name":"Acme exposure",
#     "keywords":["acme","acme-corp"],"entity_ids":[],"min_relevance":0.7,
#     "notification_channels":["slack"]}]

# ─── Advanced Configuration ──────────────────────────────────────────────────
# Deployment profile consumed by /api/health/ready and startup gates:
#   core (default) — database, worker heartbeat, embeddings and search index
#                    must be healthy; optional capabilities stay optional.
#   full           — product readiness is composed from the process/data/
#                    intelligence/delivery surfaces. Every measured capability
#                    is required (database, worker heartbeat, LLM endpoint,
#                    embeddings round trip, NATS, search index lag, browser
#                    render, crawl freshness, operational source coverage,
#                    alert-rule engine state, outbox backlog, notification
#                    delivery health, critical scheduled-job freshness) and the
#                    binary must be built with `--features llm`.
APEX_PROFILE=core
# Readiness policy thresholds (defaults shown; resolved policy is published in
# /api/health/ready responses):
# APEX_LLM_PROBE_TTL_SECS=60
# APEX_LLM_PROBE_TIMEOUT_SECS=5
# APEX_BROWSER_PROBE_TTL_SECS=300
# APEX_BROWSER_PROBE_TIMEOUT_SECS=30
# APEX_EMBEDDING_CANARY_TTL_SECS=300
# APEX_EMBEDDING_CANARY_TIMEOUT_SECS=10
# APEX_SEARCH_INDEX_MAX_LAG_SECS=3600
# APEX_CRAWL_FRESHNESS_MAX_AGE_SECS=21600
# Multidimensional capability-family coverage matrix (audit P1-9). Each family
# has APEX_COVERAGE_<FAMILY>_REQUIRED / _MIN / _FRESHNESS_SECS /
# _FETCH_SUCCESS_PCT / _PARSER_SUCCESS_PCT / _MIN_DOMAINS overrides, e.g.
# APEX_COVERAGE_PROCUREMENT_MIN=3. Certifications default to required with at
# least one operational source; disable explicitly only if the deployment
# genuinely does not promise certification coverage:
# APEX_COVERAGE_CERTIFICATIONS_REQUIRED=0.
# Malformed threshold values fail startup with a configuration error naming
# the variable and value; they are never silently replaced by defaults.
# APEX_COVERAGE_PRIORITY_COMPANY_PCT=50
# APEX_COVERAGE_PRIORITY_COMPANY_WINDOW_SECS=2592000
# APEX_ALERT_ENGINE_MAX_AGE_SECS=900
# APEX_OUTBOX_MAX_PENDING=100
# APEX_OUTBOX_MAX_OLDEST_PENDING_SECS=300
# APEX_NOTIFICATION_DELIVERY_MAX_PROCESSOR_AGE_SECS=900
# APEX_NOTIFICATION_DELIVERY_MAX_OVERDUE=250
# APEX_NOTIFICATION_DELIVERY_MAX_OVERDUE_AGE_SECS=600
# APEX_NOTIFICATION_DELIVERY_MAX_DEAD_LETTERED=25
# APEX_NOTIFICATION_DELIVERY_MAX_DEAD_LETTER_RATE=10
# APEX_NOTIFICATION_DELIVERY_MAX_STUCK_LEASES=0
# APEX_NOTIFICATION_DELIVERY_SUCCESS_WINDOW_SECS=3600
# APEX_NOTIFICATION_DELIVERY_MIN_RECENT_ATTEMPTS=5
# APEX_NOTIFICATION_DELIVERY_MIN_SUCCESS_PERCENT=90
# APEX_CRITICAL_JOBS=crawl_cycle,triage_processing
# APEX_CRITICAL_JOB_MAX_AGE_SECS=7200
# Refuse to start against an unknown database schema. When
# APEX_SKIP_MIGRATIONS=1 the applied latest migration must still match the
# embedded latest by version and checksum.
# APEX_SKIP_MIGRATIONS=0
# Road factor for distance estimation (default: 1.35)
# APEX_ROAD_FACTOR=1.35
# Maximum queue capacity for bounded queues (default: 100000)
# APEX_MAX_QUEUE_CAPACITY=100000
# Maximum JSON parse depth (default: 32)
# APEX_MAX_JSON_DEPTH=32
# Freshness half-life in days for quality scoring (default: 30)
# APEX_FRESHNESS_HALFLIFE_DAYS=30

# ─── Optional External APIs ──────────────────────────────────────────────────
# GOOGLE_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
# NEXAR_CLIENT_ID=
# NEXAR_CLIENT_SECRET=
# MOUSER_API_KEY=
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=

# ─── Notifications ───────────────────────────────────────────────────────────
# SMTP_URL=smtp://user:pass@mail.example.com:587
# SMTP_FROM=alerts@example.com
# ALERT_EMAIL=admin@example.com
# PAGE_WEBHOOK_URL=https://hooks.example.com/pager
#
# ALERT_SMTP_HOST=127.0.0.1
# ALERT_SMTP_PORT=25
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=
# ALERT_SMTP_STARTTLS=0
# ALERT_SMTP_ALLOW_PLAINTEXT=0
#   SMTP transport for alert notifications. A non-loopback host requires
#   STARTTLS; plaintext needs ALLOW_PLAINTEXT=1 and no credentials.
#
# EMAIL_DIGEST_SMTP_HOST=mail.example.com
# EMAIL_DIGEST_SMTP_PORT=587
# EMAIL_DIGEST_SMTP_USER=
# EMAIL_DIGEST_SMTP_PASS=
# EMAIL_DIGEST_SMTP_STARTTLS=1
# EMAIL_DIGEST_SMTP_ALLOW_PLAINTEXT=0
#   SMTP transport for e-mail digests (same TLS policy as alerts).
#
# APEX_DIGEST_ALLOWED_DOMAINS=example.com,example.org
#   Approved company domains for digest recipients. When set, both the
#   settings form and the worker's sender refuse any recipient outside these
#   domains (subdomains allowed); leave unset for no restriction.

# ─── Security & Hardening (New in audit remediation) ─────────────────────────
# APEX_TOR_DANGEROUS_INSECURE_TLS=0
#   Set to 1 to disable TLS certificate verification for Tor .onion connections
#   (dangerous — only enable temporarily for debugging). Default: 0 (TLS enabled)
#
# APEX_IPV6_ADDRESSES=
#   LEGACY/TOOLING ONLY: comma-separated IPv6 addresses for the archived Python
#   crawl daemon (experiments/legacy-python-crawl-daemon). The shipped Rust
#   crawler does not read this.
#   Example: "2a01:4f9:c012:a8e::1,2a01:4f9:c01f:e074::1"
#
# APEX_IPV4_ADDRESSES=
#   LEGACY/TOOLING ONLY: IPv4 fallback list for the archived Python crawl daemon.
#   Example: "77.42.65.89,95.216.182.162"
#
# APEX_DATABASE_URL=
#   Fallback database URL for Python audit tooling (used if DATABASE_URL is not
#   set). Example: "postgresql://apexintel@127.0.0.1:5432/apexintel?sslmode=require"
#
# APEX_E2E_USERNAME=aaron
#   Username for end-to-end parity capture tests.
#
# APEX_HMAC_SECRET=
#   HMAC secret key for e2e session token generation.
#   Generate: openssl rand -hex 32
#
# COOKIE_SECURE=1
#   Set to 1 when the deployment is served over HTTPS. The session cookie is
#   renamed to __Host-apex_session and gains the Secure attribute (the legacy
#   apex_session cookie issued before the rename is still accepted and is
#   cleared on logout).
#
# APEX_BASE_URL=https://starzerp.fi
#   Base URL for end-to-end tests and parity captures.
