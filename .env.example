# ══════════════════════════════════════════════════════════════════════════════
# ApexIntel Backend Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# In production, use /opt/apexintel/config/.env with chmod 600.
#
# SECURITY: Never commit actual credentials to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# Generate password: openssl rand -base64 32
# For localhost connections, sslmode is optional. For remote DB, append ?sslmode=require
DB_PASSWORD=change-me-local-dev
DATABASE_URL=postgresql://apexintel:<DB_PASSWORD>@127.0.0.1:5432/apexintel

# ─── Service URLs ────────────────────────────────────────────────────────────
# Redis authentication — set REDIS_PASSWORD to match docker-compose.yml
# Production: either set a strong random password (openssl rand -base64 32) or
# remove the password entirely if Redis is bound to localhost only.
REDIS_PASSWORD=redis_dev
REDIS_URL=redis://default:${REDIS_PASSWORD:-redis_dev}@127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-local-dev
MINIO_BUCKET=apexintel

# ─── LLM Configuration ───────────────────────────────────────────────────────
# Local llama-server for CPU inference
LLM_BASE_URL=http://127.0.0.1:8081
LLM_MODEL=Qwen3-30B-A3B-Q4_K_M
# LLM_TIMEOUT_SECS=120

# ─── API Server ──────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080
CORS_ORIGIN=http://localhost:8080
API_LOG_LEVEL=info
SEARCH_INDEX_PATH=data/search

# ─── API Authentication (REQUIRED) ───────────────────────────────────────────
# Format: <raw_key>,<display_name>,<role>
# Generate key: openssl rand -hex 32 | sed 's/^/sk-apex-/'
# Roles: admin, analyst, viewer, service
API_KEY_1=<GENERATE_API_KEY>,Development Admin,admin
# API_KEY_2=<ANOTHER_KEY>,Service Account,service

# ─── Admin authentication (for web login) ─────────────────────────────────────
APEX_ADMIN_USERNAME=admin
APEX_ADMIN_PASSWORD_HASH=<sha256 hash of password>
SESSION_SECRET=<openssl rand -hex 32>

# ─── Crawl & Scheduling ──────────────────────────────────────────────────────
CRAWL_INTERVAL_SECS=21600
NIGHTLY_HOUR_UTC=2
WEEKLY_DAY=0
DEFAULT_RPS=0.2
PROXY_POOL_SIZE=50
ENABLE_PROXY_ROTATION=false
ENABLE_HEADLESS_BROWSER=false

# ─── Worker Pipeline ─────────────────────────────────────────────────────────
WORKER_LOG_LEVEL=info
NIGHTLY_INPUT_PATH=config/runtime/nightly_inputs.json
WEEKLY_INPUT_PATH=config/runtime/weekly_inputs.json

# ─── Advanced Configuration ──────────────────────────────────────────────────
# Road factor for distance estimation (default: 1.35)
# APEX_ROAD_FACTOR=1.35
# Maximum queue capacity for bounded queues (default: 100000)
# APEX_MAX_QUEUE_CAPACITY=100000
# Maximum JSON parse depth (default: 32)
# APEX_MAX_JSON_DEPTH=32
# Freshness half-life in days for quality scoring (default: 30)
# APEX_FRESHNESS_HALFLIFE_DAYS=30

# ─── Optional External APIs ──────────────────────────────────────────────────
# GOOGLE_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
# NEXAR_CLIENT_ID=
# NEXAR_CLIENT_SECRET=
# MOUSER_API_KEY=
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=

# ─── Notifications ───────────────────────────────────────────────────────────
# SMTP_URL=smtp://user:pass@mail.example.com:587
# SMTP_FROM=alerts@example.com
# ALERT_EMAIL=admin@example.com
# PAGE_WEBHOOK_URL=https://hooks.example.com/pager

# ─── Security & Hardening (New in audit remediation) ─────────────────────────
# APEX_TOR_DANGEROUS_INSECURE_TLS=0
#   Set to 1 to disable TLS certificate verification for Tor .onion connections
#   (dangerous — only enable temporarily for debugging). Default: 0 (TLS enabled)
#
# APEX_IPV6_ADDRESSES=
#   Comma-separated list of IPv6 addresses for crawl daemon source IP rotation.
#   Example: "2a01:4f9:c012:a8e::1,2a01:4f9:c01f:e074::1"
#
# APEX_IPV4_ADDRESSES=
#   Comma-separated list of IPv4 addresses for crawl daemon source IP fallback.
#   Example: "77.42.65.89,95.216.182.162"
#
# APEX_DATABASE_URL=
#   Fallback database URL for Python scripts (used if DATABASE_URL is not set).
#   Example: "postgresql://apexintel@127.0.0.1:5432/apexintel?sslmode=require"
#
# APEX_E2E_USERNAME=aaron
#   Username for end-to-end parity capture tests.
#
# APEX_HMAC_SECRET=
#   HMAC secret key for e2e session token generation.
#   Generate: openssl rand -hex 32
#
# APEX_BASE_URL=https://starzerp.fi
#   Base URL for end-to-end tests and parity captures.
